# Hosting runtime only. Set supabase only after provider configuration and account mapping.
AUTH_PROVIDER=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=
# Google Client Secret belongs in Supabase Auth provider secrets, never this client.
# Comma-separated verified user IDs; Supabase IDs are prefixed with supabase:.
PLATFORM_ADMIN_USER_IDS=
