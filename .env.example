# Server only. Vercel Settings > Environment Variables. Never add VITE_/NEXT_PUBLIC_ prefixes.
# Supabase Connect > Transaction pooler URL (port 6543); not a browser API URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server secret key; signs private Storage transfers after checking membership.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=value-lens-documents
# Canonical origin. Add APP_URL/auth/callback to Supabase Redirect URLs.
APP_URL=
# Google Client Secret belongs in Supabase Auth provider secrets, never this client.
# Comma-separated verified user IDs; Supabase IDs are prefixed with supabase:.
PLATFORM_ADMIN_USER_IDS=
# Server secrets only. No VITE_ or NEXT_PUBLIC_ prefix. Select a Structured Outputs capable model.
OPENAI_API_KEY=
OPENAI_MODEL=
